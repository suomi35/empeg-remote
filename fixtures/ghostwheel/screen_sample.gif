ubstring(0,t)+'_';if(t++==e){t=0;if(++i<x.length)setTimeout(b,l,1)}else{setTimeout(b,s)}};window.onload = function(){o=document.getElementsByTagName('p')[0];setTimeout(b,0,1)}
